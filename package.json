{
  "name": "pioneer-health",
  "version": "1.0.0",
  "private": true,
  "description": "Pioneer Health self-service kiosk — training prototype",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "db:setup": "npm --prefix server run db:setup",
    "test": "npm --prefix client run test:run",
    "test:e2e": "npm --prefix client run test:e2e"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
