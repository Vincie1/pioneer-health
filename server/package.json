{
  "name": "pioneer-health-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "build": "prisma generate && prisma db push --accept-data-loss && node prisma/seed-if-empty.js",
    "db:setup": "prisma generate && prisma db push && node prisma/seed.js",
    "db:reset": "prisma db push --force-reset && node prisma/seed.js",
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
